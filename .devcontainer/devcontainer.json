{
  "name": "Well Forge (Tauri 2)",
  "build": {
    "dockerfile": "Dockerfile"
  },
  "features": {
    "ghcr.io/devcontainers/features/node:2": {
      "version": "24"
    }
  },
  "workspaceFolder": "/workspaces/well-forge",
  "workspaceMount": "source=${localWorkspaceFolder},target=/workspaces/well-forge,type=bind",
  "remoteUser": "vscode",
  "updateRemoteUserUID": true,
  "runArgs": ["--ipc=host"],
  "mounts": [
    "source=well-forge-node-modules,target=/workspaces/well-forge/node_modules,type=volume",
    "source=well-forge-cargo-target,target=/workspaces/well-forge/src-tauri/target,type=volume",
    "source=/tmp/.X11-unix,target=/tmp/.X11-unix,type=bind",
    "source=${localEnv:XAUTHORITY},target=/tmp/.Xauthority,type=bind,readonly"
  ],
  "containerEnv": {
    "DISPLAY": "${localEnv:DISPLAY}",
    "XAUTHORITY": "/tmp/.Xauthority",
    "GDK_BACKEND": "x11",
    "WEBKIT_DISABLE_COMPOSITING_MODE": "1"
  },
  "forwardPorts": [1420],
  "postCreateCommand": "sudo chown -R $(id -u):$(id -g) node_modules src-tauri/target && npm ci"
}
